# Never commit actual API keys.
NEBIUS_API_KEY=replace-with-secret
# Model ids default to pipeline/llm_models.yaml; override only if GET /v1/models shows a different id.
# NEMOTRON_A_MODEL_ID=nvidia/Nemotron-3_5-Lightning
# NEMOTRON_B_MODEL_ID=nvidia/Nemotron-3-Ultra-550b-a55b
# Cosmos Reason (10 video explainer) needs a Dedicated Endpoint; unset -> Nemotron-3.5-Super-VL fallback.
# COSMOS_MODEL_ID=
# COSMOS_BASE_URL=
# COSMOS_API_KEY=
# sim-eval av_stack location if it is not merged into pipeline/08_carla_paired_run/av_stack
# AV_STACK_ROOT=C:\path\to\av_stack
# SIM_EVAL_ROOT=C:\path\to\sim-eval-checkout
# Python that can import carla (default: av_stack\.venv-tfpp\Scripts\python.exe)
# AV_STACK_PYTHON=
# CARLA_HOST=localhost
# CARLA_PORT=2000
# FFMPEG=
