{
  "gp": {
    "target": "safety_margin",
    "metric_id": "recovery_success",
    "n_train": 19,
    "units": "dimensionless safety_margin = min over the final_safe_recovery criteria of (limit - observed) / limit (lane term: lane_recovery_robustness); >= 0 <=> final_safe_recovery, 0 = at the binding limit",
    "level": 0.0,
    "training_std": 0.389,
    "meaning": "safety_margin = min(lane, settle, lat_acc, lat_jerk), clipped to [-2, 1]; >= 0 exactly when the run is final_safe_recovery. lane = lane_recovery_robustness = min over the window of lane margin / (lane_width/2 - vehicle half width), dimensionless: 1 = centred, 0 = body at the lane edge, < 0 departed, collision <= -2; settle = (longest hold with |e_y| <= 0.3 m, |e_psi| <= 0.1 rad, margin >= 0 within 3 s - 1 s) / 1 s; lat_acc = (4.41 * tire_friction_scale m/s^2 - lat_acc_excess) / limit; lat_jerk = (15 m/s^3 - lat_jerk_excess) / 15. Each run reports the binding (smallest) term; observed outcomes give every term in real units (observed.safety_margin)",
    "ranking": "acquisition_score = max(recovery level-set score in training-std units - switch_penalty * (1 - p_switch), switch-classifier level-set score); the orchestrator picks runs with the same score",
    "unexplored_rule": "gp_uncertainty_vs_training_std >= 0.75"
  },
